---
import BrandIcon from './BrandIcon.astro';
import { siteContent } from '../content/siteContent';
---

<section class="access section" id="access" aria-labelledby="access-title">
  <div class="access__inner container">
    <div class="access__heading" data-reveal>
      <p class="access__eyebrow">{siteContent.shop.eyebrow}</p>
      <h2 class="access__title" id="access-title">{siteContent.shop.title}</h2>
    </div>

    <div class="access__details" data-reveal>
      <dl class="access__list">
        <div class="access__row">
          <dt class="access__term">ADDRESS</dt>
          <dd class="access__description">
            <span class="access__address">{siteContent.shop.address}</span>
            <span class="access__sub">{siteContent.shop.access}</span>
          </dd>
        </div>
        <div class="access__row">
          <dt class="access__term">OPEN</dt>
          <dd class="access__description">
            {
              siteContent.shop.hours.map((hour) => (
                <span class="access__hours">
                  <span class="access__hours-label">{hour.label}</span>
                  <span class="access__hours-value">{hour.value}</span>
                </span>
              ))
            }
            <span class="access__sub access__notice">{siteContent.shop.notice}</span>
          </dd>
        </div>
        <div class="access__row">
          <dt class="access__term">TEL</dt>
          <dd class="access__description">
            <a class="access__phone site-link" href={`tel:${siteContent.shop.telephone}`}>
              {siteContent.shop.telephoneDisplay}
            </a>
          </dd>
        </div>
        <div class="access__row">
          <dt class="access__term">SNS</dt>
          <dd class="access__description">
            <div class="access__social">
              {
                siteContent.social.map((item) => (
                  <a
                    class="access__social-link site-link"
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${item.name}を開く（新しいタブ）`}
                  >
                    <BrandIcon name={item.icon} class="access__social-icon" />
                    <span class="access__social-label">{item.name}</span>
                  </a>
                ))
              }
            </div>
          </dd>
        </div>
      </dl>

      <a
        class="access__map-link site-link"
        href={siteContent.shop.mapHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="access__map-label">GOOGLE MAPを開く</span>
        <span class="access__map-arrow" aria-hidden="true"></span>
      </a>
    </div>

    <div class="access__map" data-reveal>
      <iframe
        class="access__map-frame"
        src={siteContent.shop.mapEmbed}
        title="PEACE 所在地"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
