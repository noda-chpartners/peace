---
import { Image } from 'astro:assets';
import jewelryImage from '../assets/images/jewelry-tray.jpg';
import { siteContent } from '../content/siteContent';
---

<section class="online section" aria-labelledby="online-title">
  <div class="online__media">
    <Image
      class="online__image site-image"
      src={jewelryImage}
      alt="PEACEの店内に並ぶシルバージュエリー"
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 767px) 100vw, 52vw"
    />
  </div>
  <div class="online__content">
    <p class="online__eyebrow">{siteContent.online.eyebrow}</p>
    <h2 class="online__title" id="online-title">
      {
        siteContent.online.titleLines.map((line) => (
          <span class="online__title-line">{line}</span>
        ))
      }
    </h2>
    <p class="online__body">{siteContent.online.body}</p>
    <a
      class="online__link site-link"
      href={siteContent.online.href}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="online__link-label">{siteContent.online.label}</span>
      <span class="online__link-arrow" aria-hidden="true"></span>
    </a>
  </div>
</section>
